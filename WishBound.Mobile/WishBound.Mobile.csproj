<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WishBound.Mobile - aplicação móvel (.NET MAUI) do WishBound.
    Alvo: Android (corre nos emuladores do Visual Studio ou num
    telemóvel ligado por USB).
  -->
  <PropertyGroup>
    <TargetFrameworks>net9.0-android</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>WishBound.Mobile</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Identidade da aplicação -->
    <ApplicationTitle>WishBound</ApplicationTitle>
    <ApplicationId>pt.wishbound.mobile</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- Ícone, ecrã de arranque e ícones das abas (SVG -> PNG feito pelo MAUI na compilação) -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#14101f" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#14101f" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\*" />

    <!-- Sprites das personagens: cópias dos SVG do site (wwwroot/img/personagens),
         convertidos para PNG na compilação. Usam-se pelo nome do ficheiro: "luna.png". -->
    <MauiImage Include="Resources\Images\personagens\*.svg" BaseSize="240,240" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
  </ItemGroup>

</Project>
