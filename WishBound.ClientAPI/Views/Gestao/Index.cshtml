@model List<Personagem>
@{
    ViewData["Title"] = "Painel de personagens";
    Layout = "_LayoutGestao";
}

<div class="gestao-topo">
    <h1>Painel de personagens</h1>
    <a class="botao botao-destaque" asp-controller="Gestao" asp-action="Criar">&#43; Nova personagem</a>
</div>

<p class="texto-suave">
    Nesta área pode gerir as personagens da plataforma:
    criar (INSERT), consultar (SELECT), editar (UPDATE) e apagar (DELETE).
</p>

@if (Model.Count == 0)
{
    <div class="caixa-vazia">
        <p>Não existem personagens registadas.</p>
    </div>
}
else
{
    <table class="tabela">
        <thead>
            <tr>
                <th>Id</th>
                <th>Imagem</th>
                <th>Nome</th>
                <th>Raridade</th>
                <th>Criada em</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var personagem in Model)
            {
                <tr>
                    <td>@personagem.Id</td>
                    <td>
                        <img class="tabela-miniatura" src="@(string.IsNullOrEmpty(personagem.ImagemUrl) ? "/img/personagens/desconhecido.svg" : personagem.ImagemUrl)" alt="Miniatura de @personagem.Nome" />
                    </td>
                    <td>@personagem.Nome</td>
                    <td>
                        <span class="etiqueta-raridade" style="background:@(personagem.Raridade?.Cor ?? "#9aa5b1")">@(personagem.Raridade?.Nome ?? "-")</span>
                    </td>
                    <td>@personagem.DataCriacao.ToString("dd/MM/yyyy")</td>
                    <td class="tabela-acoes">
                        <a class="botao botao-pequeno" asp-controller="Gestao" asp-action="Editar" asp-route-id="@personagem.Id">Editar</a>
                        <a class="botao botao-pequeno botao-perigo" asp-controller="Gestao" asp-action="Apagar" asp-route-id="@personagem.Id">Apagar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
