@model LoginViewModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuracao
@{
    ViewData["Title"] = "Iniciar sessão";

    // O botão "Entrar com Google" só aparece quando há credenciais OAuth
    // configuradas no appsettings.json (Autenticacao:Google)
    bool googleAtivo = !string.IsNullOrWhiteSpace(Configuracao["Autenticacao:Google:ClientId"]) &&
                       !string.IsNullOrWhiteSpace(Configuracao["Autenticacao:Google:ClientSecret"]);
}

<div class="autenticacao-cartao">
    <h1>Iniciar sessão</h1>
    <p class="texto-suave">Bem-vindo(a) de volta ao WishBound.</p>

    <form class="formulario formulario-autenticacao" method="post"
          asp-controller="Conta" asp-action="Login" asp-route-returnUrl="@ViewBag.ReturnUrl">
        <div asp-validation-summary="ModelOnly" class="alerta alerta-erro alerta-validacao"></div>

        <div class="campo">
            <label asp-for="Identificador"></label>
            <input asp-for="Identificador" placeholder="Ex.: Luna ou luna@email.com" autofocus />
            <span asp-validation-for="Identificador" class="erro-campo"></span>
        </div>

        <div class="campo">
            <label asp-for="Password"></label>
            <input asp-for="Password" placeholder="A sua password" />
            <span asp-validation-for="Password" class="erro-campo"></span>
        </div>

        <label class="campo-caixa-verificacao">
            <input asp-for="Lembrar" />
            <span>Manter sessão iniciada</span>
        </label>

        <div class="formulario-acoes">
            <button type="submit" class="botao botao-destaque">Entrar</button>
            <a class="botao botao-suave" asp-controller="Conta" asp-action="Registar">Criar conta</a>
        </div>
    </form>

    @if (googleAtivo)
    {
        @* Login com Google (OAuth 2.0) - alternativa ao login local *@
        <div class="separador-ou"><span>ou</span></div>

        <form method="post" asp-controller="Conta" asp-action="LoginGoogle"
              asp-route-returnUrl="@ViewBag.ReturnUrl">
            <button type="submit" class="botao botao-google">
                @* Logotipo oficial "G" da Google (SVG embutido) *@
                <svg class="google-icone" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
                    <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                    <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                    <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                    <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                </svg>
                <span>Entrar com Google</span>
            </button>
        </form>
    }

    <div class="autenticacao-ligacoes">
        <a class="ligacao" asp-controller="Conta" asp-action="RecuperarPassword">Esqueci-me da password</a>
        <a class="ligacao" asp-controller="Conta" asp-action="ReenviarValidacao">Reenviar validação de email</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
