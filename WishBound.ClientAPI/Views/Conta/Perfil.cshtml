@model PerfilViewModel
@{
    ViewData["Title"] = "O meu perfil";
}

<div class="autenticacao-cartao perfil-cartao">
    <h1>O meu perfil</h1>

    <div class="perfil-cabecalho">
        @* A moldura (só as personagens Míticas dão) é um anel CSS com a cor da personagem *@
        <img class="perfil-foto @(string.IsNullOrEmpty(Model.MolduraCor) ? "" : "perfil-com-moldura")"
             style="@(string.IsNullOrEmpty(Model.MolduraCor) ? "" : "--cor-moldura:" + Model.MolduraCor)"
             src="@(string.IsNullOrEmpty(Model.FotoPerfilUrl) ? "/img/personagens/desconhecido.svg" : Model.FotoPerfilUrl)"
             alt="Foto de perfil"
             title="@Model.MolduraNome" />
        <div class="perfil-resumo">
            <p><strong>@Model.NomeUtilizador</strong> @(Model.IsAdmin ? "· Administrador" : "")</p>
            @if (!string.IsNullOrEmpty(Model.TituloNome))
            {
                @* Título escolhido no sistema de amizade (os de nível 6 têm a cor da raridade) *@
                <p class="perfil-titulo" style="@(string.IsNullOrEmpty(Model.TituloCor) ? "" : "color:" + Model.TituloCor)">@Model.TituloNome</p>
            }
            <p class="texto-suave">@Model.Email</p>
            <p class="texto-suave">Conta criada em @Model.DataCriacao.ToLocalTime().ToString("dd/MM/yyyy")</p>
            @if (Model.UltimoLogin != null)
            {
                <p class="texto-suave">Último login: @Model.UltimoLogin.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
            }
        </div>
    </div>

    @* ----- Sistema de amizade: emblemas equipados (até 3) ----- *@
    <div class="perfil-emblemas">
        @foreach (var e in Model.Emblemas)
        {
            <form method="post" asp-controller="Colecao" asp-action="EquiparEmblema" title="@e.Nome — clicar para tirar do perfil">
                <input type="hidden" name="emblemaId" value="@e.Id" />
                <input type="hidden" name="equipar" value="false" />
                <input type="hidden" name="voltar" value="perfil" />
                <button type="submit" class="perfil-emblema-botao"><img src="@e.Imagem" alt="@e.Nome" /></button>
            </form>
        }
    </div>
    <p class="texto-suave">
        Emblemas no perfil: @Model.Emblemas.Count / @Model.MaximoEmblemas (ganhos: @Model.EmblemasGanhos)
        &middot; títulos: @Model.TitulosGanhos &middot; molduras: @Model.MoldurasGanhas
        &middot; <a class="ligacao" asp-controller="Colecao" asp-action="Index">gerir na coleção</a>
    </p>

    <form class="formulario formulario-autenticacao" method="post" asp-controller="Conta" asp-action="Perfil">
        <div asp-validation-summary="ModelOnly" class="alerta alerta-erro alerta-validacao"></div>

        <div class="campo">
            <label asp-for="NomeUtilizador"></label>
            <input asp-for="NomeUtilizador" />
            <span asp-validation-for="NomeUtilizador" class="erro-campo"></span>
        </div>

        <div class="campo">
            <label asp-for="FotoPerfilUrl"></label>
            <input asp-for="FotoPerfilUrl" placeholder="Ex.: /img/personagens/luna.svg (opcional)" />
            <span asp-validation-for="FotoPerfilUrl" class="erro-campo"></span>
        </div>

        <div class="formulario-acoes">
            <button type="submit" class="botao botao-destaque">Guardar alterações</button>
            <a class="botao botao-suave" asp-controller="Conta" asp-action="AlterarPassword">Alterar password</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
