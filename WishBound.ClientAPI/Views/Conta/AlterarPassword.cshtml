@model AlterarPasswordViewModel
@{
    // A mesma página serve para alterar a password e para definir a primeira
    // (contas criadas com Google, que ainda não têm password local).
    string titulo = Model.TemPasswordLocal ? "Alterar password" : "Definir password";
    ViewData["Title"] = titulo;
}

<div class="autenticacao-cartao">
    <h1>@titulo</h1>

    @if (Model.TemPasswordLocal)
    {
        <p class="texto-suave">Para sua segurança, confirme primeiro a password atual.</p>
    }
    else
    {
        <p class="texto-suave">
            Esta conta foi criada com o Google e ainda não tem password própria.
            Ao definir uma, passa a poder entrar das duas maneiras: com o Google
            ou com o nome de utilizador e password.
        </p>
    }

    <form class="formulario formulario-autenticacao" method="post" asp-controller="Conta" asp-action="AlterarPassword">
        <div asp-validation-summary="ModelOnly" class="alerta alerta-erro alerta-validacao"></div>

        @if (Model.TemPasswordLocal)
        {
            <div class="campo">
                <label asp-for="PasswordAtual"></label>
                <input asp-for="PasswordAtual" autofocus />
                <span asp-validation-for="PasswordAtual" class="erro-campo"></span>
            </div>
        }

        <div class="campo">
            <label asp-for="NovaPassword"></label>
            <input asp-for="NovaPassword" placeholder="Mín. 8 caracteres, com maiúscula, número e símbolo" />
            <span asp-validation-for="NovaPassword" class="erro-campo"></span>
        </div>

        <div class="campo">
            <label asp-for="ConfirmarPassword"></label>
            <input asp-for="ConfirmarPassword" placeholder="Repita a nova password" />
            <span asp-validation-for="ConfirmarPassword" class="erro-campo"></span>
        </div>

        <div class="formulario-acoes">
            <button type="submit" class="botao botao-destaque">@titulo</button>
            <a class="botao botao-suave" asp-controller="Conta" asp-action="Perfil">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
