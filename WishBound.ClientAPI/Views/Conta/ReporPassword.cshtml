@model ReporPasswordViewModel
@{
    ViewData["Title"] = "Definir nova password";
}

<div class="autenticacao-cartao">
    <h1>Definir nova password</h1>
    <p class="texto-suave">Escolha a nova password da sua conta.</p>

    <form class="formulario formulario-autenticacao" method="post" asp-controller="Conta" asp-action="ReporPassword">
        <div asp-validation-summary="ModelOnly" class="alerta alerta-erro alerta-validacao"></div>

        @* O token do link segue escondido no formulário *@
        <input type="hidden" asp-for="Token" />

        <div class="campo">
            <label asp-for="NovaPassword"></label>
            <input asp-for="NovaPassword" placeholder="Mín. 8 caracteres, com maiúscula, número e símbolo" autofocus />
            <span asp-validation-for="NovaPassword" class="erro-campo"></span>
        </div>

        <div class="campo">
            <label asp-for="ConfirmarPassword"></label>
            <input asp-for="ConfirmarPassword" placeholder="Repita a nova password" />
            <span asp-validation-for="ConfirmarPassword" class="erro-campo"></span>
        </div>

        <div class="formulario-acoes">
            <button type="submit" class="botao botao-destaque">Guardar nova password</button>
            <a class="botao botao-suave" asp-controller="Conta" asp-action="Login">Cancelar</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
