<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " - " : "")WishBound</title>

    @* Fonte (elemento multimédia opcional do enunciado) - Google Fonts *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />

    @* ESTILOS GLOBAIS: aplicam-se a todas as páginas do site *@
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <link rel="icon" type="image/svg+xml" href="~/img/logo-icon.svg" />

    @* Secção para estilos LOCAIS definidos por cada página *@
    @await RenderSectionAsync("Estilos", required: false)
</head>
<body>
    @* ===== LAYOUT 1: cabeçalho no topo + conteúdo + rodapé =====
       Logotipo e menu de navegação à esquerda; o botão de conta
       (Entrar / menu do utilizador) fica no canto superior DIREITO. *@
    <header class="cabecalho">
        <a class="cabecalho-logo" asp-controller="Home" asp-action="Index">
            @* Elemento multimédia: logotipo *@
            <img src="~/img/logo.svg" alt="Logotipo WishBound" class="logo-img" />
        </a>

        @* Sistema de navegação entre as páginas *@
        <nav class="navegacao">
            <a asp-controller="Home" asp-action="Index">Início</a>
            <a asp-controller="Personagens" asp-action="Index">Personagens</a>
            <a asp-controller="Invocacao" asp-action="Index">Invocação</a>
            <a asp-controller="Eventos" asp-action="Index">Eventos</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                @* A coleção e a carteira são pessoais: só fazem sentido com sessão iniciada *@
                <a asp-controller="Colecao" asp-action="Index">Coleção</a>
                <a asp-controller="Economia" asp-action="Index">Carteira</a>
            }
            <a asp-controller="Invocacao" asp-action="Historico">Histórico</a>
            @if (User.IsInRole("Admin"))
            {
                @* A gestão é exclusiva dos administradores *@
                <a asp-controller="Gestao" asp-action="Index">Gestão</a>
            }
            <a asp-controller="Home" asp-action="Sobre">Sobre</a>
        </nav>

        @* Botão de conta empurrado para o canto superior direito *@
        <div class="area-conta">
            @if (User.Identity?.IsAuthenticated == true)
            {
                @* Sessão iniciada: menu do utilizador *@
                <details class="menu-conta">
                    <summary class="botao botao-conta">
                        <span class="conta-avatar">@(User.Identity.Name?[0])</span>
                        <span>@User.Identity.Name</span>
                        <span class="conta-seta">&#9662;</span>
                    </summary>
                    <div class="menu-conta-lista">
                        <a asp-controller="Conta" asp-action="Perfil">O meu perfil</a>
                        <a asp-controller="Economia" asp-action="Index">A minha carteira</a>
                        @* Contas criadas com Google ainda não têm password local *@
                        <a asp-controller="Conta" asp-action="AlterarPassword">
                            @(User.FindFirst("TemPasswordLocal")?.Value == "false" ? "Definir password" : "Alterar password")
                        </a>
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-controller="Gestao" asp-action="Index">Área de gestão</a>
                        }
                        <form method="post" asp-controller="Conta" asp-action="Logout">
                            <button type="submit">Terminar sessão</button>
                        </form>
                    </div>
                </details>
            }
            else
            {
                @* Sem sessão: botão de login no canto superior direito *@
                <a class="botao botao-destaque botao-conta" asp-controller="Conta" asp-action="Login">Entrar</a>
            }
        </div>
    </header>

    <main class="conteudo">
        @* Mensagens de sucesso/erro vindas dos controllers (TempData) *@
        @if (TempData["Sucesso"] != null)
        {
            <div class="alerta alerta-sucesso">@TempData["Sucesso"]</div>
        }
        @if (TempData["Erro"] != null)
        {
            <div class="alerta alerta-erro">@TempData["Erro"]</div>
        }
        @if (TempData["Reacao"] != null)
        {
            @* Sistema de amizade: a "fala" da personagem depois de uma interação *@
            <div class="caixa-reacao">&#10084; <em>@TempData["Reacao"]</em></div>
        }
        @if (TempData["LinkDev"] != null)
        {
            @* MODO DE DESENVOLVIMENTO: sem envio real de emails, o link de
               validação/recuperação é mostrado aqui (simula o email recebido) *@
            <div class="caixa-link-dev">
                <p><strong>@TempData["LinkDevTitulo"]</strong> <span class="texto-suave">(modo de desenvolvimento — este link seria enviado por email)</span></p>
                <a class="ligacao" href="@TempData["LinkDev"]">@TempData["LinkDev"]</a>
            </div>
        }

        @RenderBody()
    </main>

    <footer class="rodape">
        <img src="~/img/logo-icon.svg" alt="Ícone WishBound" class="rodape-icone" />
        <p>WishBound &copy; 2026 &middot; Projeto Final UFCD 11027 &middot; Plataforma de Coleção Digital de Personagens</p>
    </footer>

    @* CONTAGEM DECRESCENTE dos banners de evento: qualquer elemento com
       data-fim="<data ISO em UTC>" passa a mostrar "3d 04:12:07" e a
       atualizar-se a cada segundo (usado na Invocação, nos Eventos, na
       página inicial e na Carteira). Sem JavaScript fica o texto que o
       servidor escreveu. *@
    <script>
        (function () {
            var elementos = document.querySelectorAll('[data-fim]');
            if (elementos.length === 0) { return; }

            function dois(n) { return (n < 10 ? '0' : '') + n; }

            function atualizar() {
                var agora = Date.now();
                elementos.forEach(function (el) {
                    var fim = Date.parse(el.getAttribute('data-fim'));
                    if (isNaN(fim)) { return; }
                    var resta = Math.floor((fim - agora) / 1000);

                    if (resta <= 0) {
                        el.textContent = 'terminado';
                        el.classList.add('contagem-fim');
                        el.classList.remove('contagem-perto');
                        return;
                    }

                    var d = Math.floor(resta / 86400);
                    var h = Math.floor((resta % 86400) / 3600);
                    var m = Math.floor((resta % 3600) / 60);
                    var s = resta % 60;
                    el.textContent = (d > 0 ? d + 'd ' : '') + dois(h) + ':' + dois(m) + ':' + dois(s);

                    // Último dia: muda de cor
                    if (resta < 86400) { el.classList.add('contagem-perto'); }
                });
            }

            atualizar();
            setInterval(atualizar, 1000);
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
