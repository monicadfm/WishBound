@model InvocacaoViewModel
@{
    ViewData["Title"] = "Invocação";
}

@* ESTILO LOCAL: painéis dos banners (montra), miniaturas de troca,
   garantias, animação e grelha de resultados — só nesta página *@
@section Estilos {
    <style>
        .invocacao-zona {
            text-align: center;
            padding: 30px 20px 10px;
        }

        /* ----- Painel de um banner (a "montra"): um por banner, só o
           escolhido está visível; as miniaturas em baixo trocam-nos ----- */
        .painel-banner {
            --cor-banner: #b04ac7;
            max-width: 860px;
            margin: 0 auto 18px;
            padding: 18px 22px 22px;
            border: 3px solid var(--cor-banner);
            border-radius: 18px;
            background:
                radial-gradient(ellipse at 50% 0%, color-mix(in srgb, var(--cor-banner) 22%, transparent), transparent 60%),
                var(--fundo-suave);
            box-shadow: 0 0 40px color-mix(in srgb, var(--cor-banner) 25%, transparent);
            animation: aparecer 0.45s ease-out;
        }

        .painel-banner.permanente {
            --cor-banner: #8b1a2b;
        }

        .painel-topo {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
        }

        .painel-topo h2 {
            font-size: 1.35rem;
            margin: 0;
        }

        .painel-tipo {
            display: inline-block;
            padding: 2px 10px;
            border-radius: 999px;
            border: 1px solid var(--cor-banner);
            color: var(--texto);
            font-size: 0.75rem;
            font-weight: 700;
            letter-spacing: 0.5px;
            margin-left: 8px;
            vertical-align: middle;
        }

        /* Montra: Mítica grande ao centro, Lendárias mais pequenas e mais
           baixas dos lados (como no esboço) */
        .montra {
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            align-items: end;
            gap: 10px;
            margin: 18px auto 10px;
            min-height: 300px;
        }

        .montra-personagem {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
            text-decoration: none;
        }

        .montra-personagem .foto {
            width: 140px;
            height: 140px;
            border-radius: 50%;
            border: 4px solid var(--cor-raridade, #9aa5b1);
            background: radial-gradient(circle at 50% 30%, var(--cor-raridade, #9aa5b1) 0%, var(--fundo) 78%);
            box-shadow: 0 0 26px color-mix(in srgb, var(--cor-raridade, #9aa5b1) 55%, transparent);
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            transition: transform 0.2s;
        }

        .montra-personagem:hover .foto {
            transform: scale(1.05);
        }

        .montra-personagem .foto img {
            width: 82%;
            height: 82%;
        }

        .montra-centro {
            align-self: start;
        }

        .montra-centro .foto {
            width: 250px;
            height: 250px;
            border-width: 5px;
        }

        .montra-personagem strong {
            font-family: 'Cinzel', 'Georgia', serif;
            font-size: 1.05rem;
        }

        .montra-centro strong {
            font-size: 1.3rem;
        }

        .montra-lado.esquerda {
            justify-self: end;
            margin-right: 6px;
        }

        .montra-lado.direita {
            justify-self: start;
            margin-left: 6px;
        }

        .montra-vazio {
            grid-column: 1 / -1;
            color: var(--texto-suave);
            padding: 40px 0;
        }

        /* ----- Setas laterais para trocar de banner ----- */
        .carrossel {
            position: relative;
            max-width: 860px;
            margin: 0 auto;
        }

        .seta-banner {
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            width: 52px;
            height: 52px;
            border-radius: 50%;
            border: 2px solid var(--borda);
            background: var(--fundo-cartao);
            color: var(--dourado);
            font-size: 1.6rem;
            line-height: 1;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 6px 18px rgba(0, 0, 0, .45);
            transition: transform 0.15s, border-color 0.15s;
            z-index: 2;
        }

        .seta-banner:hover {
            border-color: var(--dourado);
            transform: translateY(-50%) scale(1.08);
        }

        .seta-banner.esquerda {
            left: -26px;
        }

        .seta-banner.direita {
            right: -26px;
        }

        @@media (max-width: 960px) {
            .seta-banner.esquerda {
                left: 6px;
            }

            .seta-banner.direita {
                right: 6px;
            }
        }

        /* ----- Miniaturas para trocar de banner ----- */
        .miniaturas {
            display: flex;
            gap: 14px;
            justify-content: center;
            flex-wrap: wrap;
            margin: 0 auto 26px;
        }

        .miniaturas-rotulo {
            display: block;
            font-size: 0.8rem;
            margin-bottom: 8px;
        }

        .mini-banner {
            --cor-banner: #b04ac7;
            width: 190px;
            padding: 10px 12px;
            border: 3px solid var(--cor-banner);
            border-radius: 12px;
            background: var(--fundo-cartao);
            color: var(--texto);
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 10px;
            text-align: left;
            opacity: 0.72;
            transition: transform 0.15s, opacity 0.15s, box-shadow 0.15s;
            font: inherit;
        }

        .mini-banner.permanente {
            --cor-banner: #8b1a2b;
        }

        .mini-banner:hover {
            opacity: 1;
            transform: translateY(-2px);
        }

        .mini-banner.ativo {
            opacity: 1;
            box-shadow: 0 0 0 2px var(--cor-banner), 0 0 18px color-mix(in srgb, var(--cor-banner) 55%, transparent);
        }

        .mini-banner img {
            width: 46px;
            height: 46px;
            border-radius: 50%;
            border: 2px solid var(--cor-raridade, #9aa5b1);
            background: radial-gradient(circle at 50% 30%, var(--cor-raridade, #9aa5b1) 0%, var(--fundo) 78%);
            flex-shrink: 0;
        }

        .mini-banner strong {
            display: block;
            font-size: 0.9rem;
            line-height: 1.2;
        }

        .mini-banner .contagem {
            font-size: 0.75rem;
            padding: 1px 8px;
            margin-top: 3px;
        }

        /* ----- Garantias, estilo contagem: "Épico em 7 invocações" ----- */
        .garantias {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 8px;
            margin: 16px auto 14px;
        }

        .garantia-linha {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 0.95rem;
        }

        .garantia-linha strong {
            font-family: 'Cinzel', 'Georgia', serif;
            font-size: 1rem;
            letter-spacing: 0.3px;
        }

        .garantia-linha > span:not(.garantia-contador) {
            color: var(--texto-suave);
        }

        .garantia-contador {
            display: inline-flex;
            align-items: center;
            padding: 3px 12px;
            border-radius: 999px;
            background: rgba(243, 192, 79, .12);
            border: 1px solid rgba(243, 192, 79, .45);
            color: var(--dourado);
            font-weight: 700;
            font-variant-numeric: tabular-nums;
        }

        .garantia-contador.perto {
            background: rgba(231, 76, 60, .14);
            border-color: rgba(231, 76, 60, .55);
            color: #ff8b7d;
        }

        .saldos {
            display: flex;
            justify-content: center;
            gap: 16px;
            flex-wrap: wrap;
            margin: 0 0 14px;
            font-size: 0.9rem;
        }

        .botoes-invocar {
            display: flex;
            gap: 12px;
            justify-content: center;
            flex-wrap: wrap;
        }

        /* ----- Resultado ----- */
        .resultado-cartao {
            margin: 30px auto 0;
            max-width: 340px;
            animation: aparecer 0.8s ease-out;
        }

        .grelha-resultados {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
            gap: 14px;
            margin: 28px auto 0;
            max-width: 820px;
            text-align: left;
        }

        .resultado-mini {
            animation: aparecer 0.6s ease-out;
        }

        .marca-novo, .marca-pity {
            display: inline-block;
            border-radius: 999px;
            padding: 2px 8px;
            font-size: 12px;
            font-weight: 600;
            margin-right: 6px;
        }

        .marca-novo {
            background: #2f8f5b;
            color: #fff;
        }

        .marca-pity {
            background: #F1C40F;
            color: #2b2b2b;
        }

        @@keyframes aparecer {
            from {
                opacity: 0;
                transform: translateY(30px) scale(0.9);
            }
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        /* ----- Botão "i" no canto do painel + janela das probabilidades ----- */
        .botao-info {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            border: 2px solid var(--cor-banner);
            background: var(--fundo-cartao);
            color: var(--dourado);
            font-family: 'Georgia', serif;
            font-style: italic;
            font-weight: 700;
            font-size: 0.95rem;
            line-height: 1;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            transition: transform 0.15s, box-shadow 0.15s;
        }

        .botao-info:hover {
            transform: scale(1.1);
            box-shadow: 0 0 12px color-mix(in srgb, var(--cor-banner) 60%, transparent);
        }

        .painel-topo .topo-direita {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .janela-probabilidades {
            --cor-banner: #b04ac7;
            width: min(640px, calc(100vw - 32px));
            max-height: calc(100vh - 48px);
            padding: 0;
            border: 2px solid var(--cor-banner);
            border-radius: 16px;
            background: var(--fundo-suave);
            color: var(--texto);
            box-shadow: 0 0 50px color-mix(in srgb, var(--cor-banner) 35%, transparent), 0 20px 60px rgba(0, 0, 0, .6);
            text-align: left;
        }

        .janela-probabilidades.permanente {
            --cor-banner: #8b1a2b;
        }

        .janela-probabilidades::backdrop {
            background: rgba(6, 3, 14, .78);
            backdrop-filter: blur(3px);
        }

        .janela-cabecalho {
            position: sticky;
            top: 0;
            z-index: 1;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            padding: 14px 18px;
            border-bottom: 1px solid var(--borda);
            background: var(--fundo-suave);
        }

        .janela-cabecalho h3 {
            margin: 0;
            font-size: 1.1rem;
        }

        .janela-cabecalho .texto-suave {
            display: block;
            font-size: 0.8rem;
            margin-top: 2px;
        }

        .janela-fechar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            border: 1px solid var(--borda);
            background: var(--fundo-cartao);
            color: var(--texto);
            font-size: 1.1rem;
            line-height: 1;
            cursor: pointer;
            flex-shrink: 0;
        }

        .janela-fechar:hover {
            border-color: var(--dourado);
            color: var(--dourado);
        }

        .janela-corpo {
            padding: 14px 18px 18px;
        }

        .janela-corpo .tabela {
            width: 100%;
            margin: 0 0 16px;
        }

        .janela-corpo .tabela td:last-child,
        .janela-corpo .tabela th:last-child {
            text-align: right;
        }

        .janela-subtitulo {
            font-family: 'Cinzel', 'Georgia', serif;
            font-size: 0.95rem;
            color: var(--dourado);
            margin: 18px 0 8px;
        }

        .prob-grupo {
            margin-bottom: 14px;
            border: 1px solid var(--borda);
            border-radius: 12px;
            overflow: hidden;
        }

        .prob-grupo-topo {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
            padding: 8px 12px;
            background: var(--fundo-cartao);
            font-size: 0.85rem;
        }

        .prob-grupo-topo strong {
            font-size: 0.95rem;
        }

        .prob-linha {
            display: grid;
            grid-template-columns: 34px 1fr auto;
            align-items: center;
            gap: 10px;
            padding: 6px 12px;
            border-top: 1px solid var(--borda);
            color: var(--texto);
            text-decoration: none;
            font-size: 0.9rem;
        }

        .prob-linha:hover {
            background: rgba(255, 255, 255, .04);
        }

        .prob-linha img {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            border: 2px solid var(--cor-raridade, #9aa5b1);
            background: radial-gradient(circle at 50% 30%, var(--cor-raridade, #9aa5b1) 0%, var(--fundo) 78%);
        }

        .prob-linha .marca-rateup, .prob-linha .marca-exclusiva {
            font-size: 9px;
            padding: 1px 6px;
            margin: 0 0 0 6px;
        }

        .prob-linha .valor {
            font-variant-numeric: tabular-nums;
            font-weight: 700;
        }

        .prob-linha.rateup .valor {
            color: var(--dourado);
        }

        .janela-regras {
            font-size: 0.86rem;
            line-height: 1.5;
            margin: 0;
        }

        @@media (max-width: 640px) {
            .montra {
                grid-template-columns: 1fr;
                justify-items: center;
                min-height: 0;
            }

            .montra-centro .foto {
                width: 200px;
                height: 200px;
            }

            .montra-lado.esquerda, .montra-lado.direita {
                justify-self: center;
                margin: 0;
            }
        }
    </style>
}

<section class="invocacao-zona">
    <h1 class="titulo-seccao">Invocação</h1>

    @if (Model.Banners.Count == 0)
    {
        <p class="caixa-vazia">Não há banners a decorrer neste momento.</p>
    }

    @* ============================================================
       UM PAINEL POR BANNER (todos na mesma página). Só o escolhido está
       visível; as miniaturas em baixo trocam-nos no browser, sem
       recarregar. Cada painel tem a sua montra, as suas garantias (o
       pity conta-se por banner) e os seus botões.
       ============================================================ *@
    <div class="carrossel">
    @if (Model.Banners.Count > 1)
    {
        <button type="button" class="seta-banner esquerda" data-direcao="-1" title="Banner anterior" aria-label="Banner anterior">&#10094;</button>
        <button type="button" class="seta-banner direita" data-direcao="1" title="Banner seguinte" aria-label="Banner seguinte">&#10095;</button>
    }

    @foreach (var banner in Model.Banners)
    {
        var estado = Model.EstadoDe(banner.Id);
        var centro = banner.Centro;
        var lados = banner.Lados;
        bool ativo = banner.Id == Model.BannerId;

        <div class="painel-banner @(banner.Permanente ? "permanente" : "")" data-banner="@banner.Id" hidden="@(!ativo)">
            <div class="painel-topo">
                <h2>
                    @banner.Nome
                    <span class="painel-tipo">@(banner.Permanente ? "STANDARD" : "EVENTO")</span>
                    @if (banner.Terminado)
                    {
                        <span class="painel-tipo" title="Evento terminado: só os administradores continuam a ver e a invocar aqui">TERMINADO · SÓ ADMIN</span>
                    }
                </h2>
                <span class="topo-direita">
                    @if (banner.Permanente)
                    {
                        <span class="contagem contagem-fim">permanente</span>
                    }
                    else
                    {
                        <span class="contagem" data-fim="@banner.FimIso" title="Termina a @banner.DataFim.ToLocalTime().ToString("dd/MM/yyyy HH:mm")">@banner.TempoRestanteTexto</span>
                    }
                    <button type="button" class="botao-info" data-janela="probabilidades-@banner.Id"
                            title="Probabilidades e garantias" aria-label="Ver probabilidades e garantias deste banner">i</button>
                </span>
            </div>

            @* ----- Montra: a mais rara ao centro, as outras dos lados ----- *@
            <div class="montra">
                @if (centro == null)
                {
                    <p class="montra-vazio">Este banner ainda não tem personagens.</p>
                }
                else
                {
                    var esquerda = lados.Count > 0 ? lados[0] : null;
                    var direita = lados.Count > 1 ? lados[1] : null;

                    <div class="montra-lado esquerda">
                        @if (esquerda != null)
                        {
                            <a class="montra-personagem" style="--cor-raridade:@esquerda.CorOuOmissao" asp-controller="Personagens" asp-action="Details" asp-route-id="@esquerda.Id">
                                <span class="foto"><img src="@esquerda.Imagem" alt="Imagem da personagem @esquerda.Nome" /></span>
                                <strong>@esquerda.Nome</strong>
                                <span class="etiqueta-raridade" style="background:@esquerda.CorOuOmissao">@esquerda.RaridadeNome</span>
                                <span>
                                    @if (esquerda.RateUp)
                                    {
                                        <span class="marca-rateup">RATE-UP @esquerda.QuotaTexto</span>
                                    }
                                    @if (esquerda.Exclusiva)
                                    {
                                        <span class="marca-exclusiva">EXCLUSIVA</span>
                                    }
                                </span>
                            </a>
                        }
                    </div>

                    <a class="montra-personagem montra-centro" style="--cor-raridade:@centro.CorOuOmissao" asp-controller="Personagens" asp-action="Details" asp-route-id="@centro.Id">
                        <span class="foto"><img src="@centro.Imagem" alt="Imagem da personagem @centro.Nome" /></span>
                        <strong>@centro.Nome</strong>
                        <span class="etiqueta-raridade" style="background:@centro.CorOuOmissao">@centro.RaridadeNome</span>
                        <span>
                            @if (centro.RateUp)
                            {
                                <span class="marca-rateup">RATE-UP @centro.QuotaTexto</span>
                            }
                            @if (centro.Exclusiva)
                            {
                                <span class="marca-exclusiva">EXCLUSIVA</span>
                            }
                        </span>
                    </a>

                    <div class="montra-lado direita">
                        @if (direita != null)
                        {
                            <a class="montra-personagem" style="--cor-raridade:@direita.CorOuOmissao" asp-controller="Personagens" asp-action="Details" asp-route-id="@direita.Id">
                                <span class="foto"><img src="@direita.Imagem" alt="Imagem da personagem @direita.Nome" /></span>
                                <strong>@direita.Nome</strong>
                                <span class="etiqueta-raridade" style="background:@direita.CorOuOmissao">@direita.RaridadeNome</span>
                                <span>
                                    @if (direita.RateUp)
                                    {
                                        <span class="marca-rateup">RATE-UP @direita.QuotaTexto</span>
                                    }
                                    @if (direita.Exclusiva)
                                    {
                                        <span class="marca-exclusiva">EXCLUSIVA</span>
                                    }
                                </span>
                            </a>
                        }
                    </div>
                }
            </div>

            @if (estado != null)
            {
                var corEpico = Model.Raridades.FirstOrDefault(r => r.Nome.StartsWith("Épic", StringComparison.OrdinalIgnoreCase))?.Cor ?? "#9b59b6";
                var corLendario = Model.Raridades.FirstOrDefault(r => r.Nome.StartsWith("Lend", StringComparison.OrdinalIgnoreCase))?.Cor ?? "#f1c40f";

                @* ----- Garantias (pity) NESTE banner, estilo contagem ----- *@
                <div class="garantias">
                    <div class="garantia-linha">
                        <strong style="color:@corEpico">Épico</strong>
                        <span>em</span>
                        <span class="garantia-contador">@estado.FaltamParaEpico @(estado.FaltamParaEpico == 1 ? "invocação" : "invocações")</span>
                    </div>
                    <div class="garantia-linha">
                        <strong style="color:@corLendario">Lendário</strong>
                        <span>em</span>
                        <span class="garantia-contador @(estado.EmSoftPity ? "perto" : "")" title="@(estado.EmSoftPity ? "A probabilidade sobe a cada invocação até à garantia" : "")">@estado.FaltamParaLendario @(estado.FaltamParaLendario == 1 ? "invocação" : "invocações")</span>
                    </div>
                </div>

                <p class="texto-suave saldos">
                    <span>&#128176; @estado.SaldoMoedas.ToString("0") Moedas</span>
                    <span>&#127915; @estado.SaldoBilhetes.ToString("0") @(estado.SaldoBilhetes == 1 ? "bilhete" : "bilhetes")</span>
                    @if (!estado.PodeInvocar)
                    {
                        <span>Liberta cópias repetidas na Coleção para ganhar mais.</span>
                    }
                </p>
            }


            @* ----- Botões: 1 ou 10 de cada vez, neste banner ----- *@
            <form class="botoes-invocar" method="post" asp-controller="Invocacao" asp-action="Invocar">
                <input type="hidden" name="bannerId" value="@banner.Id" />
                <button type="submit" name="quantidade" value="1" class="botao botao-destaque botao-grande">
                    &#10024; Invocar (@(estado?.PrecoTexto(1) ?? "10 Moedas"))
                </button>
                <button type="submit" name="quantidade" value="10" class="botao botao-suave botao-grande">
                    &#10024; Invocar x10 (@(estado?.PrecoTexto(10) ?? "100 Moedas"))
                </button>
            </form>
        </div>
    }
    </div>

    @* ----- Miniaturas: clicar troca o painel visível ----- *@
    @if (Model.Banners.Count > 1)
    {
        <div class="miniaturas" role="tablist" aria-label="Escolher banner">
            @foreach (var banner in Model.Banners)
            {
                var centro = banner.Centro;
                <button type="button" role="tab"
                        class="mini-banner @(banner.Permanente ? "permanente" : "") @(banner.Id == Model.BannerId ? "ativo" : "")"
                        data-alvo="@banner.Id" aria-selected="@(banner.Id == Model.BannerId ? "true" : "false")"
                        style="--cor-raridade:@(centro?.CorOuOmissao ?? "#9aa5b1")">
                    <img src="@(centro?.Imagem ?? "/img/personagens/desconhecido.svg")" alt="" />
                    <span>
                        <strong>@banner.Nome</strong>
                        @if (banner.Permanente)
                        {
                            <span class="contagem contagem-fim">standard</span>
                        }
                        else
                        {
                            <span class="contagem" data-fim="@banner.FimIso">@banner.TempoRestanteTexto</span>
                        }
                    </span>
                </button>
            }
        </div>
    }

    @* ----- Resultado ----- *@
    @if (Model.Resultado != null && Model.Resultado.Personagens.Count == 1)
    {
        var obtida = Model.Resultado.Personagens[0];

        <div class="cartao resultado-cartao">
            <div class="cartao-imagem" style="--cor-raridade:@obtida.Cor">
                <img src="@obtida.Imagem" alt="Imagem da personagem @obtida.Personagem?.Nome" />
            </div>
            <div class="cartao-corpo">
                <h3>Obtiveste: @(obtida.Personagem?.Nome)!</h3>
                <span class="etiqueta-raridade" style="background:@obtida.Cor">@(obtida.Personagem?.Raridade?.Nome ?? "Desconhecida")</span>

                <p class="texto-suave">
                    @if (obtida.Novo)
                    {
                        <span class="marca-novo">NOVA</span>
                    }
                    @if (obtida.PityAtivado)
                    {
                        <span class="marca-pity">GARANTIA</span>
                    }
                    @if (obtida.RateUp)
                    {
                        <span class="marca-rateup">RATE-UP</span>
                    }
                    @if (obtida.Exclusiva)
                    {
                        <span class="marca-exclusiva">EXCLUSIVA</span>
                    }
                    @if (obtida.GarantiaRateUpUsada)
                    {
                        <span class="marca-cinquenta">GARANTIA DO 50/50</span>
                    }
                    else if (obtida.PerdeuCinquenta)
                    {
                        <span class="marca-cinquenta">50/50 PERDIDO</span>
                    }
                    @if (!obtida.Novo)
                    {
                        <text>Repetida — ficas com @obtida.Quantidade cópias.</text>
                        @if (obtida.PontosAmizadeGanhos > 0)
                        {
                            <text> +@obtida.PontosAmizadeGanhos amizade (@obtida.NivelAmizadeNome).</text>
                        }
                    }
                    <br />
                    @Model.Resultado.GastoTexto &middot;
                    espaço da coleção: @Model.Resultado.Ocupado / @Model.Resultado.Capacidade
                    &middot; saldo: @Model.Resultado.SaldoMoedas.ToString("0") Moedas, @Model.Resultado.SaldoBilhetes.ToString("0") bilhetes
                </p>

                <a class="botao botao-suave" asp-controller="Colecao" asp-action="Detalhes" asp-route-id="@obtida.Personagem?.Id">Ver na coleção</a>
            </div>
        </div>
    }
    else if (Model.Resultado != null && Model.Resultado.Personagens.Count > 1)
    {
        <p class="texto-suave">
            @Model.Resultado.Personagens.Count invocações em @Model.Resultado.BannerNome &middot;
            @Model.Resultado.GastoTexto (saldo: @Model.Resultado.SaldoMoedas.ToString("0") Moedas, @Model.Resultado.SaldoBilhetes.ToString("0") bilhetes) &middot;
            espaço da coleção: @Model.Resultado.Ocupado / @Model.Resultado.Capacidade
        </p>

        <div class="grelha-resultados">
            @foreach (var obtida in Model.Resultado.Personagens)
            {
                <div class="cartao resultado-mini">
                    <div class="cartao-imagem" style="--cor-raridade:@obtida.Cor">
                        <img src="@obtida.Imagem" alt="Imagem da personagem @obtida.Personagem?.Nome" />
                    </div>
                    <div class="cartao-corpo">
                        <h3>@obtida.Personagem?.Nome</h3>
                        <span class="etiqueta-raridade" style="background:@obtida.Cor">@(obtida.Personagem?.Raridade?.Nome ?? "Desconhecida")</span>
                        <p class="texto-suave">
                            @if (obtida.Novo)
                            {
                                <span class="marca-novo">NOVA</span>
                            }
                            @if (obtida.PityAtivado)
                            {
                                <span class="marca-pity">GARANTIA</span>
                            }
                            @if (obtida.RateUp)
                            {
                                <span class="marca-rateup">RATE-UP</span>
                            }
                            @if (obtida.Exclusiva)
                            {
                                <span class="marca-exclusiva">EXCLUSIVA</span>
                            }
                            @if (obtida.GarantiaRateUpUsada)
                            {
                                <span class="marca-cinquenta">GARANTIA 50/50</span>
                            }
                            else if (obtida.PerdeuCinquenta)
                            {
                                <span class="marca-cinquenta">50/50 PERDIDO</span>
                            }
                            @if (!obtida.Novo)
                            {
                                <text>x@(obtida.Quantidade)</text>
                                @if (obtida.PontosAmizadeGanhos > 0)
                                {
                                    <text> &middot; +@obtida.PontosAmizadeGanhos &#10084;</text>
                                }
                            }
                        </p>
                    </div>
                </div>
            }
        </div>
    }

    @* ----- 50/50: aviso depois de perder ----- *@
    @if (Model.Resultado != null && Model.Resultado.Personagens.Any(p => p.PerdeuCinquenta))
    {
        <p class="texto-suave" style="margin-top:14px">
            Saiu uma Mítica do banner permanente — perdeste o 50/50. Não faz mal:
            <strong>a próxima Mítica neste banner é garantida a do evento.</strong>
        </p>
    }

    @* ----- Amizade: subidas de nível provocadas por esta invocação ----- *@
    @if (Model.Resultado != null && Model.Resultado.MensagensAmizade.Count > 0)
    {
        <div class="destaque-caixa">
            @foreach (var mensagem in Model.Resultado.MensagensAmizade)
            {
                <p>&#10084; @mensagem</p>
            }
            <a class="ligacao" asp-controller="Colecao" asp-action="Index">ver na coleção</a>
        </div>
    }

    @* ============================================================
       JANELA DE PROBABILIDADES (uma por banner, escondida): abre no "i"
       do canto do painel. Mostra a tabela por raridade, TODAS as
       personagens do banner com o % de cada uma (como num gacha real) e
       as regras das garantias.
       ============================================================ *@
    @foreach (var banner in Model.Banners)
    {
        var grupos = Model.ProbabilidadesDe(banner.Id);
        var estado = Model.EstadoDe(banner.Id);
        int limiteEpico = estado?.LimiteEpico ?? 10;
        int limiteLendario = estado?.LimiteLendario ?? 90;
        int inicioSoft = estado?.InicioSoftPity ?? 81;

        <dialog id="probabilidades-@banner.Id" class="janela-probabilidades @(banner.Permanente ? "permanente" : "")"
                aria-labelledby="probabilidades-@banner.Id-titulo">
            <div class="janela-cabecalho">
                <div>
                    <h3 id="probabilidades-@banner.Id-titulo">Probabilidades &middot; @banner.Nome</h3>
                    <span class="texto-suave">
                        @(banner.Permanente ? "Banner standard" : "Banner de evento") &middot; @banner.TotalPersonagens personagens
                        @if (banner.TotalExclusivas > 0)
                        {
                            <text>&middot; @banner.TotalExclusivas exclusivas</text>
                        }
                        &middot; <a class="ligacao" asp-controller="Eventos" asp-action="Index" asp-route-bannerId="@banner.Id">ver página do banner</a>
                    </span>
                </div>
                <button type="button" class="janela-fechar" data-fechar title="Fechar" aria-label="Fechar">&#10005;</button>
            </div>

            <div class="janela-corpo">
                @* ----- Tabela por raridade ----- *@
                @if (Model.Raridades.Count > 0)
                {
                    <table class="tabela">
                        <caption>Probabilidades por raridade</caption>
                        <thead>
                            <tr>
                                <th>Raridade</th>
                                <th>Probabilidade</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var raridade in Model.Raridades)
                            {
                                <tr>
                                    <td><span class="etiqueta-raridade" style="background:@raridade.Cor">@raridade.Nome</span></td>
                                    <td>@raridade.ProbabilidadePercentagem</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

                @* ----- Personagens e a probabilidade de cada uma ----- *@
                <h4 class="janela-subtitulo">Personagens deste banner</h4>
                @if (grupos.Count == 0)
                {
                    <p class="texto-suave">Não foi possível obter a lista de personagens deste banner.</p>
                }
                else
                {
                    <p class="texto-suave" style="font-size:0.82rem;margin:0 0 10px">
                        Probabilidade de cada personagem numa invocação (antes das garantias).
                        @if (!banner.Permanente && grupos.Any(g => g.TemRateUp))
                        {
                            <text>Dentro de cada raridade, as <span class="marca-rateup">RATE-UP</span> repartem a quota indicada; as restantes repartem o resto.</text>
                        }
                    </p>

                    foreach (var grupo in grupos)
                    {
                        <div class="prob-grupo">
                            <div class="prob-grupo-topo">
                                <span>
                                    <span class="etiqueta-raridade" style="background:@grupo.Cor">@grupo.RaridadeNome</span>
                                    <span class="texto-suave">@grupo.Linhas.Count @(grupo.Linhas.Count == 1 ? "personagem" : "personagens")</span>
                                    @if (grupo.TemRateUp)
                                    {
                                        <span class="texto-suave">&middot; rate-up @(grupo.QuotaTexto)@(grupo.RaridadeOrdem >= 5 ? " (50/50)" : "")</span>
                                    }
                                </span>
                                <strong>@grupo.ProbabilidadeTexto</strong>
                            </div>
                            @foreach (var linha in grupo.Linhas)
                            {
                                var p = linha.Personagem;
                                bool emRateUp = grupo.TemRateUp && p.RateUp;
                                <a class="prob-linha @(emRateUp ? "rateup" : "")" style="--cor-raridade:@p.CorOuOmissao"
                                   asp-controller="Personagens" asp-action="Details" asp-route-id="@p.Id">
                                    <img src="@p.Imagem" alt="" />
                                    <span>
                                        @p.Nome
                                        @if (emRateUp)
                                        {
                                            <span class="marca-rateup">RATE-UP</span>
                                        }
                                        @if (p.Exclusiva)
                                        {
                                            <span class="marca-exclusiva">EXCLUSIVA</span>
                                        }
                                    </span>
                                    <span class="valor">@linha.ProbabilidadeTexto</span>
                                </a>
                            }
                        </div>
                    }
                }

                @* ----- Regras das garantias ----- *@
                <h4 class="janela-subtitulo">Garantias</h4>
                <p class="texto-suave janela-regras">
                    Uma Épica (ou melhor) a cada @limiteEpico invocações sem nenhuma —
                    por isso uma invocação x10 traz sempre pelo menos uma Épica — e uma
                    Lendária ou Mítica à @(limiteLendario).ª. Até à @(inicioSoft - 1).ª as
                    probabilidades são as da tabela; a partir da @(inicioSoft).ª sobem a
                    cada invocação até à garantia. As garantias contam-se por banner.
                    @if (!banner.Permanente)
                    {
                        <text>
                            Neste banner de evento as probabilidades por raridade são as mesmas:
                            o <span class="marca-rateup">RATE-UP</span> só decide qual personagem
                            sai dentro da raridade. Na Mítica é um 50/50 — se sair a do banner
                            standard, a próxima Mítica é garantida a do evento.
                        </text>
                    }
                </p>
            </div>
        </dialog>
    }
</section>

@section Scripts {
    @* Troca de banner sem recarregar: mostra o painel do banner clicado,
       marca a miniatura como ativa e atualiza o URL (para um refresh ou
       uma invocação voltarem ao mesmo banner). *@
    <script>
        (function () {
            var miniaturas = Array.prototype.slice.call(document.querySelectorAll('.mini-banner'));
            var paineis = document.querySelectorAll('.painel-banner');

            function mostrar(alvo) {
                paineis.forEach(function (painel) {
                    painel.hidden = painel.getAttribute('data-banner') !== alvo;
                });

                miniaturas.forEach(function (m) {
                    var ativo = m.getAttribute('data-alvo') === alvo;
                    m.classList.toggle('ativo', ativo);
                    m.setAttribute('aria-selected', ativo ? 'true' : 'false');
                });

                if (window.history && history.replaceState) {
                    var url = new URL(window.location.href);
                    url.searchParams.set('bannerId', alvo);
                    history.replaceState(null, '', url.toString());
                }
            }

            miniaturas.forEach(function (mini) {
                mini.addEventListener('click', function () {
                    mostrar(mini.getAttribute('data-alvo'));
                });
            });

            // Setas laterais (e teclas ← →): anterior / seguinte, em círculo
            function saltar(direcao) {
                if (miniaturas.length < 2) { return; }
                var atual = miniaturas.findIndex(function (m) { return m.classList.contains('ativo'); });
                var proximo = (atual + direcao + miniaturas.length) % miniaturas.length;
                mostrar(miniaturas[proximo].getAttribute('data-alvo'));
            }

            document.querySelectorAll('.seta-banner').forEach(function (seta) {
                seta.addEventListener('click', function () {
                    saltar(parseInt(seta.getAttribute('data-direcao'), 10));
                });
            });

            document.addEventListener('keydown', function (e) {
                if (e.target.tagName === 'INPUT' || e.target.tagName === 'SELECT' || e.target.tagName === 'TEXTAREA') { return; }
                if (document.querySelector('dialog[open]')) { return; }
                if (e.key === 'ArrowLeft') { saltar(-1); }
                if (e.key === 'ArrowRight') { saltar(1); }
            });

            // Janela das probabilidades: o "i" do painel abre a do seu banner;
            // fecha no ✕, com Esc (nativo do <dialog>) ou a clicar fora.
            document.querySelectorAll('.botao-info').forEach(function (botao) {
                botao.addEventListener('click', function () {
                    var janela = document.getElementById(botao.getAttribute('data-janela'));
                    if (!janela) { return; }
                    if (typeof janela.showModal === 'function') { janela.showModal(); }
                    else { janela.setAttribute('open', ''); }
                });
            });

            document.querySelectorAll('.janela-probabilidades').forEach(function (janela) {
                janela.querySelector('[data-fechar]').addEventListener('click', function () {
                    janela.close();
                });

                janela.addEventListener('click', function (e) {
                    if (e.target === janela) { janela.close(); }
                });
            });
        })();
    </script>
}
