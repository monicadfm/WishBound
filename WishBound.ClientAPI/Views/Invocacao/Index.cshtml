@model InvocacaoViewModel
@{
    ViewData["Title"] = "Invocação";
}

@* ESTILO LOCAL: animação usada apenas nesta página *@
@section Estilos {
    <style>
        /* Estilo local da página de invocação */
        .invocacao-zona {
            text-align: center;
            padding: 40px 20px 10px;
        }

        .resultado-cartao {
            margin: 30px auto 0;
            max-width: 340px;
            animation: aparecer 0.8s ease-out;
        }

        @@keyframes aparecer {
            from {
                opacity: 0;
                transform: translateY(30px) scale(0.9);
            }
            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        .tabela-probabilidades {
            margin: 40px auto 0;
            max-width: 480px;
        }
    </style>
}

<section class="invocacao-zona">
    <h1 class="titulo-seccao">Invocação</h1>
    <p class="texto-suave">
        Pede um desejo e invoca uma personagem aleatória.
        Cada invocação fica registada no teu histórico pessoal e a personagem
        entra na tua coleção (operação INSERT através da WebAPI).
    </p>

    <form method="post" asp-controller="Invocacao" asp-action="Invocar">
        <button type="submit" class="botao botao-destaque botao-grande">&#10024; Invocar personagem</button>
    </form>

    @if (Model.Resultado?.Personagem != null)
    {
        var personagem = Model.Resultado.Personagem;
        var cor = personagem.Raridade?.Cor ?? "#9aa5b1";

        <div class="cartao resultado-cartao">
            <div class="cartao-imagem" style="--cor-raridade:@cor">
                <img src="@(string.IsNullOrEmpty(personagem.ImagemUrl) ? "/img/personagens/desconhecido.svg" : personagem.ImagemUrl)" alt="Imagem da personagem @personagem.Nome" />
            </div>
            <div class="cartao-corpo">
                <h3>Obtiveste: @personagem.Nome!</h3>
                <span class="etiqueta-raridade" style="background:@cor">@(personagem.Raridade?.Nome ?? "Desconhecida")</span>

                @* Novidade ou repetida: a personagem entrou na coleção *@
                <p class="texto-suave">
                    @if (Model.Resultado.Novo)
                    {
                        <strong>Nova na tua coleção!</strong>
                    }
                    else
                    {
                        <text>Repetida — ficas com @Model.Resultado.Quantidade cópias.</text>
                    }
                    <br />
                    Espaço da coleção: @Model.Resultado.Ocupado / @Model.Resultado.Capacidade
                </p>

                <p class="texto-suave">@personagem.Descricao</p>

                <a class="botao botao-suave" asp-controller="Colecao" asp-action="Detalhes" asp-route-id="@personagem.Id">Ver na coleção</a>
            </div>
        </div>
    }

    @if (Model.Raridades.Count > 0)
    {
        <table class="tabela tabela-probabilidades">
            <caption>Probabilidades por raridade</caption>
            <thead>
                <tr>
                    <th>Raridade</th>
                    <th>Probabilidade</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var raridade in Model.Raridades)
                {
                    <tr>
                        <td><span class="etiqueta-raridade" style="background:@raridade.Cor">@raridade.Nome</span></td>
                        <td>@raridade.ProbabilidadePercentagem</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>
