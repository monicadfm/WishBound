@using WishBound.ClientAPI.Models.Colecao
@using WishBound.ClientAPI.Models.Amizade
@model DetalhesColecaoViewModel
@{
    var item = Model.Item;
    var amizade = Model.Amizade;
    var mensagens = Model.Mensagens;
    ViewData["Title"] = item.Nome;
}

@* ESTILO LOCAL: botões em formulários e o bloco de amizade por baixo da descrição *@
@section Estilos {
    <style>
        .detalhe-acoes {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            align-items: center;
            margin-top: 18px;
        }

        /* ----- Amizade com esta personagem ----- */
        .amizade-painel {
            margin-top: 18px;
            padding: 16px 18px;
            border-radius: 12px;
            background: rgba(208, 70, 138, .10);
            border: 1px solid rgba(243, 154, 198, .35);
        }

        .amizade-painel h2 {
            font-size: 1.05rem;
            margin-bottom: 4px;
        }

        .amizade-cabecalho {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            align-items: center;
            justify-content: space-between;
        }

        .interacoes-pontos {
            display: inline-flex;
            gap: 6px;
            vertical-align: middle;
        }

        .interacoes-pontos span {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            border: 2px solid var(--dourado);
        }

        .interacoes-pontos span.cheio {
            background: var(--dourado);
            box-shadow: 0 0 8px rgba(243, 192, 79, .6);
        }

        .amizade-barra {
            height: 8px;
            border-radius: 6px;
            background: rgba(255, 255, 255, .12);
            overflow: hidden;
            margin: 8px 0 6px;
        }

        .amizade-usado {
            height: 100%;
            border-radius: 6px;
            background: linear-gradient(90deg, #d0468a, #f39ac6);
        }

        .nivel-maximo .amizade-usado {
            background: linear-gradient(90deg, #f3c04f, #fff1b8);
        }

        /* Lista dos níveis: um por linha, com o que dá */
        .niveis {
            list-style: none;
            margin: 12px 0 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .niveis li {
            display: grid;
            grid-template-columns: 26px 1fr auto;
            gap: 10px;
            align-items: center;
            font-size: 0.92rem;
            padding: 6px 10px;
            border-radius: 8px;
            background: rgba(255, 255, 255, .04);
        }

        .niveis li .marca {
            width: 22px;
            height: 22px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: 700;
            border: 1px solid var(--borda);
            color: var(--texto-suave);
        }

        .niveis li.atingido .marca {
            background: #d0468a;
            border-color: #f39ac6;
            color: #fff;
        }

        .niveis li.atual {
            outline: 1px solid rgba(243, 154, 198, .6);
        }

        .niveis li.fora {
            opacity: .45;
        }

        .niveis li .recompensa {
            color: var(--texto-suave);
        }

        .niveis li .recompensa form {
            display: inline;
            margin-left: 8px;
        }

        .niveis li .recompensa button {
            font-size: 12px;
            padding: 3px 8px;
        }

        .titulo-cor {
            font-weight: 600;
        }

        .amizade-painel .interagir {
            margin-top: 12px;
            display: flex;
            gap: 10px;
            align-items: center;
            flex-wrap: wrap;
        }

        /* ----- Mensagens da personagem ----- */
        .balao-saudacao {
            position: relative;
            margin: 14px 0 4px;
            padding: 12px 16px;
            border-radius: 14px;
            background: rgba(255, 255, 255, .07);
            border: 1px solid rgba(243, 154, 198, .45);
            font-style: italic;
            line-height: 1.5;
        }

        .balao-saudacao::before {
            content: "";
            position: absolute;
            left: 22px;
            top: -8px;
            width: 14px;
            height: 14px;
            transform: rotate(45deg);
            background: rgba(46, 34, 72, 1);
            border-left: 1px solid rgba(243, 154, 198, .45);
            border-top: 1px solid rgba(243, 154, 198, .45);
        }

        .balao-saudacao .quem {
            font-style: normal;
            font-weight: 600;
            color: var(--dourado);
            margin-right: 6px;
        }

        .companheira-acao {
            display: flex;
            gap: 10px;
            align-items: center;
            flex-wrap: wrap;
            margin: 10px 0 0;
        }

        .companheira-acao form {
            display: inline;
        }

        .mensagens-painel {
            margin-top: 18px;
            padding: 16px 18px;
            border-radius: 12px;
            background: rgba(255, 255, 255, .04);
            border: 1px solid var(--borda);
        }

        .mensagens-painel h2 {
            font-size: 1.05rem;
            margin: 0;
            display: inline;
        }

        /* Fechado por omissão: só o título; abre ao clicar */
        .mensagens-painel summary {
            list-style: none;
            cursor: pointer;
        }

        .mensagens-painel summary::-webkit-details-marker {
            display: none;
        }

        .mensagens-painel[open] summary {
            margin-bottom: 4px;
        }

        .mensagens-painel summary::before {
            content: "\25B8  ";
            color: var(--dourado);
        }

        .mensagens-painel[open] summary::before {
            content: "\25BE  ";
        }

        .mensagens-painel summary:hover h2 {
            color: var(--dourado);
        }

        .mensagens-tipo {
            margin-top: 12px;
        }

        .mensagens-tipo h3 {
            font-size: 0.95rem;
            margin-bottom: 2px;
        }

        .mensagens-lista {
            list-style: none;
            margin: 6px 0 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .mensagens-lista li {
            display: grid;
            grid-template-columns: auto 1fr;
            gap: 10px;
            align-items: baseline;
            font-size: 0.92rem;
            padding: 6px 10px;
            border-radius: 8px;
            background: rgba(255, 255, 255, .04);
        }

        .mensagens-lista li.bloqueada {
            color: var(--texto-suave);
        }

        .mensagens-lista li.fora {
            opacity: .45;
        }

        .mensagens-lista .nivel-etiqueta {
            font-size: 11px;
            font-weight: 600;
            padding: 2px 7px;
            border-radius: 999px;
            border: 1px solid var(--borda);
            color: var(--texto-suave);
            white-space: nowrap;
        }

        .mensagens-lista li.desbloqueada .nivel-etiqueta {
            border-color: #f39ac6;
            color: #f39ac6;
        }
    </style>
}

<section class="seccao">
    <div class="detalhe-grelha">
        <div class="detalhe-imagem" style="--cor-raridade:@item.Cor">
            <img src="@item.Imagem" alt="Imagem da personagem @item.Nome" />
        </div>

        <div class="detalhe-info">
            <h1>@item.Nome@(item.IsFavorito ? " ★" : "")</h1>
            <span class="etiqueta-raridade" style="background:@item.Cor">@item.RaridadeNome</span>

            <p class="detalhe-descricao">
                @(string.IsNullOrEmpty(item.Descricao) ? "Esta personagem ainda não tem descrição." : item.Descricao)
            </p>

            @* ============================================================
               SAUDAÇÃO — o que a personagem te diz hoje (muda com o nível)
               ============================================================ *@
            @if (mensagens != null && !string.IsNullOrEmpty(mensagens.Saudacao))
            {
                <div class="balao-saudacao"><span class="quem">@item.Nome:</span>@mensagens.Saudacao</div>
            }
            @if (mensagens != null)
            {
                <div class="companheira-acao">
                    @if (mensagens.EhCompanheira)
                    {
                        <span class="texto-suave">&#127968; @item.Nome é a tua companheira: recebe-te na página inicial.</span>
                        <form method="post" asp-controller="Colecao" asp-action="Companheira">
                            @* sem personagemId = deixar de ter companheira; volta a esta página *@
                            <input type="hidden" name="voltar" value="detalhes" />
                            <input type="hidden" name="voltarId" value="@item.PersonagemId" />
                            <button type="submit" class="botao botao-suave">Deixar de ser companheira</button>
                        </form>
                    }
                    else
                    {
                        <form method="post" asp-controller="Colecao" asp-action="Companheira">
                            <input type="hidden" name="personagemId" value="@item.PersonagemId" />
                            <button type="submit" class="botao botao-suave" title="Só podes ter uma companheira; substitui a atual">
                                &#127968; Tornar companheira da página inicial
                            </button>
                        </form>
                    }
                </div>
            }

            @* ============================================================
               AMIZADE com esta personagem — logo por baixo da descrição
               ============================================================ *@
            @if (amizade != null)
            {
                <div class="amizade-painel @(amizade.NivelMaximo ? "nivel-maximo" : "")">
                    <div class="amizade-cabecalho">
                        <h2>Amizade: @amizade.NivelAmizadeNome <span class="texto-suave">(nível @amizade.NivelOrdem de @amizade.NivelMaximoOrdem)</span></h2>
                        <span class="texto-suave">
                            Interações de hoje@(amizade.InteracoesRestantes > amizade.InteracoesPorDia ? ": ∞" : "")
                            <span class="interacoes-pontos">
                                @for (int i = 0; i < amizade.InteracoesPorDia; i++)
                                {
                                    <span class="@(i < amizade.InteracoesRestantes ? "cheio" : "")"></span>
                                }
                            </span>
                        </span>
                    </div>

                    <div class="amizade-barra" title="@amizade.ProgressoTexto">
                        <div class="amizade-usado" style="width:@(amizade.Percentagem)%"></div>
                    </div>
                    <span class="texto-suave">
                        @amizade.ProgressoTexto
                        @if (amizade.UltimaInteracao != null)
                        {
                            <text>&middot; última interação a @amizade.UltimaInteracao.Value.ToString("dd/MM/yyyy")</text>
                        }
                    </span>

                    @* Os níveis, com o que cada um dá para ESTA personagem *@
                    <ul class="niveis">
                        @foreach (var n in amizade.Niveis)
                        {
                            string classe = (n.Atingido ? "atingido" : "") + (n.Ordem == amizade.NivelOrdem ? " atual" : "") + (n.Alcancavel ? "" : " fora");
                            <li class="@classe" title="@(n.Alcancavel ? "" : "Uma personagem " + amizade.RaridadeNome + " não chega a este nível")">
                                <span class="marca">@(n.Atingido ? "✓" : n.Ordem.ToString())</span>
                                <span><strong>@n.Nome</strong> <span class="texto-suave">· @n.PontosNecessarios pts</span></span>
                                <span class="recompensa">
                                    @switch (n.Ordem)
                                    {
                                        case 3:
                                            if (amizade.Titulo != null)
                                            {
                                                <text>Título <strong>@amizade.Titulo.Nome</strong></text>
                                                if (amizade.Titulo.Obtido)
                                                {
                                                    <form method="post" asp-controller="Colecao" asp-action="EquiparTitulo">
                                                        @if (!amizade.Titulo.Equipado)
                                                        {
                                                            <input type="hidden" name="tituloId" value="@amizade.Titulo.Id" />
                                                        }
                                                        <input type="hidden" name="personagemId" value="@amizade.PersonagemId" />
                                                        <button type="submit" class="botao @(amizade.Titulo.Equipado ? "botao-suave" : "botao-destaque")">
                                                            @(amizade.Titulo.Equipado ? "Tirar do perfil" : "Usar no perfil")
                                                        </button>
                                                    </form>
                                                }
                                            }
                                            else
                                            {
                                                <text>@n.Recompensa</text>
                                            }
                                            break;
                                        case 4:
                                            <text>Notificações personalizadas de @amizade.Nome</text>
                                            if (amizade.NotificacoesAtivas)
                                            {
                                                <text> — <em>ativas</em></text>
                                            }
                                            break;
                                        case 5:
                                            if (amizade.Emblema != null)
                                            {
                                                <text>Emblema <strong>@amizade.Emblema.Nome</strong> <span class="texto-suave">(até @amizade.MaximoEmblemasEquipados no perfil)</span></text>
                                                if (amizade.Emblema.Obtido)
                                                {
                                                    <form method="post" asp-controller="Colecao" asp-action="EquiparEmblema">
                                                        <input type="hidden" name="emblemaId" value="@amizade.Emblema.Id" />
                                                        <input type="hidden" name="equipar" value="@((!amizade.Emblema.Equipado).ToString().ToLower())" />
                                                        <input type="hidden" name="personagemId" value="@amizade.PersonagemId" />
                                                        <button type="submit" class="botao @(amizade.Emblema.Equipado ? "botao-suave" : "botao-destaque")">
                                                            @(amizade.Emblema.Equipado ? "Tirar do perfil" : "Pôr no perfil")
                                                        </button>
                                                    </form>
                                                }
                                            }
                                            else
                                            {
                                                <text>@n.Recompensa</text>
                                            }
                                            break;
                                        case 6:
                                            if (amizade.TituloUnico != null)
                                            {
                                                <text>Título único <span class="titulo-cor" style="color:@(amizade.TituloUnico.CorHex ?? item.Cor)">@amizade.TituloUnico.Nome</span></text>
                                                if (amizade.TituloUnico.Obtido)
                                                {
                                                    <form method="post" asp-controller="Colecao" asp-action="EquiparTitulo">
                                                        @if (!amizade.TituloUnico.Equipado)
                                                        {
                                                            <input type="hidden" name="tituloId" value="@amizade.TituloUnico.Id" />
                                                        }
                                                        <input type="hidden" name="personagemId" value="@amizade.PersonagemId" />
                                                        <button type="submit" class="botao @(amizade.TituloUnico.Equipado ? "botao-suave" : "botao-destaque")">
                                                            @(amizade.TituloUnico.Equipado ? "Tirar do perfil" : "Usar no perfil")
                                                        </button>
                                                    </form>
                                                }
                                            }
                                            else
                                            {
                                                <text>@n.Recompensa</text>
                                            }
                                            break;
                                        case 7:
                                            if (amizade.Moldura != null)
                                            {
                                                <text>Moldura <strong>@amizade.Moldura.Nome</strong></text>
                                                if (amizade.Moldura.Obtida)
                                                {
                                                    <form method="post" asp-controller="Colecao" asp-action="EquiparMoldura">
                                                        @if (!amizade.Moldura.Equipada)
                                                        {
                                                            <input type="hidden" name="molduraId" value="@amizade.Moldura.Id" />
                                                        }
                                                        <input type="hidden" name="personagemId" value="@amizade.PersonagemId" />
                                                        <button type="submit" class="botao @(amizade.Moldura.Equipada ? "botao-suave" : "botao-destaque")">
                                                            @(amizade.Moldura.Equipada ? "Tirar do perfil" : "Pôr no perfil")
                                                        </button>
                                                    </form>
                                                }
                                            }
                                            else
                                            {
                                                <text>@n.Recompensa</text>
                                            }
                                            break;
                                        default:
                                            <text>—</text>
                                            break;
                                    }
                                </span>
                            </li>
                        }
                    </ul>

                    @* ----- Mensagens desbloqueadas / por desbloquear ----- *@
                    @if (mensagens != null && mensagens.Total > 0)
                    {
                        <details class="mensagens-painel">
                            <summary>
                                <h2>Mensagens de @item.Nome <span class="texto-suave">· @mensagens.Desbloqueadas de @mensagens.Total desbloqueadas</span></h2>
                            </summary>
                            <span class="texto-suave">Cada nível de amizade desbloqueia falas novas; a personagem escolhe ao acaso entre todas as que já desbloqueaste.</span>

                            @foreach (var grupo in mensagens.PorTipo)
                            {
                                <div class="mensagens-tipo">
                                    <h3>@Mensagem.NomeTipo(grupo.Key) <span class="texto-suave">— @Mensagem.DescricaoTipo(grupo.Key)</span></h3>
                                    <ul class="mensagens-lista">
                                        @foreach (var m in grupo)
                                        {
                                            <li class="@(m.Desbloqueada ? "desbloqueada" : "bloqueada")@(m.Alcancavel ? "" : " fora")"
                                                title="@(m.Alcancavel ? "" : "Uma personagem " + item.RaridadeNome + " não chega a este nível")">
                                                <span class="nivel-etiqueta">@(m.Desbloqueada ? "✓ " : "🔒 ")Nível @m.NivelOrdem</span>
                                                @if (m.Desbloqueada)
                                                {
                                                    <span>@m.Conteudo</span>
                                                }
                                                else
                                                {
                                                    <span><em>Desbloqueia ao nível @m.NivelOrdem (@m.NivelNome)@(m.Alcancavel ? "" : " — fora do alcance desta raridade")</em></span>
                                                }
                                            </li>
                                        }
                                    </ul>
                                </div>
                            }
                        </details>
                    }

                    <form class="interagir" method="post" asp-controller="Colecao" asp-action="Interagir">
                        <input type="hidden" name="personagemId" value="@item.PersonagemId" />
                        <input type="hidden" name="voltar" value="detalhes" />
                        <button type="submit" class="botao @(amizade.TemInteracoes ? "botao-destaque" : "botao-suave")"
                                title="Gasta 1 das @amizade.InteracoesPorDia interações do dia (+@amizade.PontosPorInteracao pontos)">
                            &#10084; Interagir com @item.Nome
                        </button>
                        <span class="texto-suave">
                            +@amizade.PontosPorInteracao pontos por interação; as cópias repetidas também contam
                            (@(ProgressoAmizade.PontosRepetida(item.RaridadeOrdem)) por cópia @item.RaridadeNome, o dobro num evento).
                        </span>
                    </form>
                </div>
            }

            <table class="tabela">
                <tbody>
                    <tr>
                        <th>Cópias</th>
                        <td>@item.Quantidade @(item.Repetidas > 0 ? "(" + item.Repetidas + " repetida(s))" : "")</td>
                    </tr>
                    <tr>
                        <th>Obtida em</th>
                        <td>@item.DataObtencao.ToString("dd/MM/yyyy HH:mm")</td>
                    </tr>
                    <tr>
                        <th>Favorita</th>
                        <td>@(item.IsFavorito ? "Sim" : "Não")</td>
                    </tr>
                </tbody>
            </table>

            <div class="detalhe-acoes">
                <a class="botao botao-suave" asp-controller="Colecao" asp-action="Index">&#8592; Voltar à coleção</a>

                <form method="post" asp-controller="Colecao" asp-action="Favorito">
                    <input type="hidden" name="personagemId" value="@item.PersonagemId" />
                    <input type="hidden" name="favorito" value="@((!item.IsFavorito).ToString().ToLower())" />
                    <input type="hidden" name="voltar" value="detalhes" />
                    <button type="submit" class="botao botao-suave">
                        @(item.IsFavorito ? "Remover dos favoritos" : "Marcar como favorita")
                    </button>
                </form>

                @if (item.Repetidas > 0)
                {
                    <form method="post" asp-controller="Colecao" asp-action="Libertar">
                        <input type="hidden" name="personagemId" value="@item.PersonagemId" />
                        <input type="hidden" name="quantidade" value="0" />
                        <input type="hidden" name="voltar" value="detalhes" />
                        <button type="submit" class="botao botao-suave" title="Fica sempre com uma cópia; recebe Moedas conforme a raridade">
                            Libertar as @item.Repetidas repetidas
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</section>
