@using WishBound.ClientAPI.Models.Colecao
@model ColecaoViewModel
@{
    ViewData["Title"] = "A minha coleção";
}

@* ESTILO LOCAL: barra de capacidade e detalhes dos cartões da coleção *@
@section Estilos {
    <style>
        .colecao-topo {
            display: flex;
            flex-wrap: wrap;
            gap: 18px;
            align-items: flex-end;
            justify-content: space-between;
            margin-bottom: 22px;
        }

        .capacidade {
            min-width: 260px;
            flex: 1;
        }

        .capacidade-barra {
            height: 10px;
            border-radius: 6px;
            background: rgba(255, 255, 255, .12);
            overflow: hidden;
            margin-top: 6px;
        }

        .capacidade-usado {
            height: 100%;
            border-radius: 6px;
            background: linear-gradient(90deg, #6d5bd0, #b28cf0);
        }

        .capacidade-cheia .capacidade-usado {
            background: linear-gradient(90deg, #c0483f, #e07a72);
        }

        .filtros-colecao {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            align-items: center;
        }

        .cartao-colecao {
            position: relative;
        }

        .etiqueta-quantidade {
            position: absolute;
            top: 10px;
            left: 10px;
            background: rgba(15, 17, 26, .82);
            color: #fff;
            border-radius: 999px;
            padding: 3px 10px;
            font-size: 13px;
            font-weight: 600;
        }

        .etiqueta-favorito {
            position: absolute;
            top: 8px;
            right: 10px;
            font-size: 20px;
            line-height: 1;
        }

        .linha-expansao {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
            margin-top: 10px;
        }

        .cartao-acoes {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
            margin-top: 10px;
        }

        .cartao-acoes button {
            font-size: 13px;
            padding: 6px 10px;
        }

        /* Amizade: nível e barra de progresso em cada cartão */
        .etiqueta-nivel {
            display: inline-block;
            border-radius: 999px;
            padding: 2px 10px;
            font-size: 12px;
            font-weight: 600;
            background: rgba(208, 70, 138, .25);
            border: 1px solid rgba(243, 154, 198, .5);
            margin-left: 6px;
        }

        .amizade-barra {
            height: 6px;
            border-radius: 6px;
            background: rgba(255, 255, 255, .12);
            overflow: hidden;
            margin-top: 8px;
        }

        .amizade-usado {
            height: 100%;
            border-radius: 6px;
            background: linear-gradient(90deg, #d0468a, #f39ac6);
        }

        .interacoes-caixa {
            margin-top: 10px;
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .interacoes-pontos {
            display: inline-flex;
            gap: 6px;
        }

        .interacoes-pontos span {
            width: 14px;
            height: 14px;
            border-radius: 50%;
            border: 2px solid var(--dourado);
        }

        .interacoes-pontos span.cheio {
            background: var(--dourado);
            box-shadow: 0 0 8px rgba(243, 192, 79, .6);
        }
    </style>
}

<section class="seccao">
    <div class="colecao-topo">
        <div>
            <h1 class="titulo-seccao">A minha coleção</h1>
            <p class="texto-suave">
                @Model.PersonagensDistintas de @Model.PersonagensExistentes personagens diferentes.
                As cópias repetidas também ocupam espaço — libertá-las dá Moedas,
                e as Moedas compram mais lugares.
            </p>
        </div>

        <div class="capacidade @(Model.Cheia ? "capacidade-cheia" : "")">
            <span class="texto-suave">
                Espaço: <strong>@Model.Ocupado / @Model.Capacidade</strong>
                &middot; Moedas: <strong>@Model.SaldoMoedas.ToString("0")</strong>
            </span>
            <div class="capacidade-barra">
                <div class="capacidade-usado" style="width:@(Model.PercentagemOcupada)%"></div>
            </div>

            @if (Model.Cheia)
            {
                <p class="texto-suave">Coleção cheia — liberte repetidas ou compre mais lugares para poder invocar.</p>
            }

            @* Sistema de amizade: interações que ainda tem hoje (3 por dia) *@
            <div class="interacoes-caixa texto-suave">
                <span>&#10084; Interações de hoje:</span>
                <span class="interacoes-pontos">
                    @for (int i = 0; i < Model.InteracoesPorDia; i++)
                    {
                        <span class="@(i < Model.InteracoesRestantes ? "cheio" : "")"></span>
                    }
                </span>
                <strong>@(Model.InteracoesRestantes > Model.InteracoesPorDia ? "∞" : Model.InteracoesRestantes + " / " + Model.InteracoesPorDia)</strong>
                <span>@(Model.TemInteracoes ? "· +25 pontos cada, em qualquer personagem" : "· voltam amanhã")</span>
            </div>

            @* Libertar de uma vez as repetidas de todas as personagens *@
            @if (Model.TemRepetidas)
            {
                <form class="linha-expansao" method="post" asp-controller="Colecao" asp-action="LibertarTudo">
                    <input type="hidden" name="ordenar" value="@Model.Ordenar" />
                    <input type="hidden" name="favoritos" value="@Model.ApenasFavoritos.ToString().ToLower()" />
                    <button type="submit" class="botao botao-suave"
                            title="Fica sempre com uma cópia de cada personagem">
                        Libertar todas as repetidas (@Model.TotalRepetidas)
                    </button>
                    <span class="texto-suave">+@Model.MoedasPorTodasRepetidas.ToString("0") Moedas</span>
                </form>
            }

            @* Expansão do inventário paga em Moedas (ganhas ao libertar repetidas).
               Sem preço não há dados da API (ex.: API em baixo): não mostra nada. *@
            @if (Model.PrecoProximaExpansao > 0)
            {
            <form class="linha-expansao" method="post" asp-controller="Colecao" asp-action="Expandir">
                <input type="hidden" name="ordenar" value="@Model.Ordenar" />
                <input type="hidden" name="favoritos" value="@Model.ApenasFavoritos.ToString().ToLower()" />
                <button type="submit" class="botao @(Model.PodeExpandir ? "botao-destaque" : "botao-suave")">
                    +@Model.LugaresPorExpansao lugares por @Model.PrecoProximaExpansao.ToString("0") Moedas
                </button>
                @if (!Model.PodeExpandir)
                {
                    <span class="texto-suave">Faltam @((Model.PrecoProximaExpansao - Model.SaldoMoedas).ToString("0")) Moedas</span>
                }
            </form>
            }
        </div>
    </div>

    @* Ordenação e filtro (GET, para o endereço poder ser guardado/partilhado) *@
    <form class="filtros-colecao" method="get" asp-controller="Colecao" asp-action="Index">
        <label for="ordenar">Ordenar por</label>
        <select id="ordenar" name="ordenar" onchange="this.form.submit()">
            <option value="raridade" selected="@(Model.Ordenar == "raridade")">Raridade</option>
            <option value="nome" selected="@(Model.Ordenar == "nome")">Nome</option>
            <option value="data" selected="@(Model.Ordenar == "data")">Data de obtenção</option>
        </select>

        <label>
            <input type="checkbox" name="favoritos" value="true" onchange="this.form.submit()" checked="@Model.ApenasFavoritos" />
            Apenas favoritas
        </label>

        <noscript><button type="submit" class="botao">Aplicar</button></noscript>
    </form>

    @if (Model.Itens.Count == 0)
    {
        <div class="caixa-vazia">
            <p>
                @(Model.ApenasFavoritos
                    ? "Ainda não marcou nenhuma personagem como favorita."
                    : "A sua coleção está vazia.")
            </p>
            <a class="botao botao-destaque" asp-controller="Invocacao" asp-action="Index">&#10024; Invocar uma personagem</a>
        </div>
    }
    else
    {
        <div class="grelha-cartoes">
            @foreach (var item in Model.Itens)
            {
                <div class="cartao cartao-colecao">
                    <div class="cartao-imagem" style="--cor-raridade:@item.Cor">
                        <img src="@item.Imagem" alt="Imagem da personagem @item.Nome" />
                        @if (item.Quantidade > 1)
                        {
                            <span class="etiqueta-quantidade">&times;@item.Quantidade</span>
                        }
                        @if (item.IsFavorito)
                        {
                            <span class="etiqueta-favorito" title="Favorita">&#9733;</span>
                        }
                    </div>

                    <div class="cartao-corpo">
                        <h3>@item.Nome</h3>
                        <span class="etiqueta-raridade" style="background:@item.Cor">@item.RaridadeNome</span>
                        <span class="etiqueta-nivel" title="@item.NivelTexto — @item.ProgressoAmizadeTexto">@item.NivelAmizadeNome</span>
                        <div class="amizade-barra" title="@item.ProgressoAmizadeTexto">
                            <div class="amizade-usado" style="width:@(item.PercentagemAmizade)%"></div>
                        </div>
                        <p class="texto-suave">Obtida a @item.DataObtencao.ToString("dd/MM/yyyy")</p>

                        <div class="cartao-acoes">
                            <a class="botao botao-suave" asp-controller="Colecao" asp-action="Detalhes" asp-route-id="@item.PersonagemId">Detalhes</a>

                            @* Sistema de amizade: gasta 1 das 3 interações do dia nesta personagem *@
                            <form method="post" asp-controller="Colecao" asp-action="Interagir">
                                <input type="hidden" name="personagemId" value="@item.PersonagemId" />
                                <input type="hidden" name="ordenar" value="@Model.Ordenar" />
                                <input type="hidden" name="favoritos" value="@Model.ApenasFavoritos.ToString().ToLower()" />
                                <button type="submit" class="botao @(Model.TemInteracoes ? "botao-destaque" : "botao-suave")" title="+25 pontos de amizade">
                                    &#10084; Interagir
                                </button>
                            </form>

                            <form method="post" asp-controller="Colecao" asp-action="Favorito">
                                <input type="hidden" name="personagemId" value="@item.PersonagemId" />
                                <input type="hidden" name="favorito" value="@((!item.IsFavorito).ToString().ToLower())" />
                                <input type="hidden" name="ordenar" value="@Model.Ordenar" />
                                <input type="hidden" name="favoritos" value="@Model.ApenasFavoritos.ToString().ToLower()" />
                                <button type="submit" class="botao botao-suave">
                                    @(item.IsFavorito ? "Remover dos favoritos" : "Favorita")
                                </button>
                            </form>

                            @if (item.Repetidas > 0)
                            {
                                <form method="post" asp-controller="Colecao" asp-action="Libertar">
                                    <input type="hidden" name="personagemId" value="@item.PersonagemId" />
                                    <input type="hidden" name="quantidade" value="1" />
                                    <input type="hidden" name="ordenar" value="@Model.Ordenar" />
                                    <input type="hidden" name="favoritos" value="@Model.ApenasFavoritos.ToString().ToLower()" />
                                    <button type="submit" class="botao botao-suave" title="Liberta espaço e dá Moedas conforme a raridade">
                                        Libertar repetida (@item.Repetidas)
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</section>
